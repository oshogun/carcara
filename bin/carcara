#!/usr/bin/env bash
# Deprecated shim: runs the Python carcara CLI from this checkout.
set -euo pipefail
resolve_home() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}
CARCARA_HOME="${CARCARA_HOME:-$(resolve_home)}"
[ -d "$CARCARA_HOME/src/carcara" ] || { echo "carcara: $CARCARA_HOME/src/carcara not found (stale CARCARA_HOME?)" >&2; exit 1; }
# shellcheck disable=SC2016 # literal backticks
echo 'carcara: bin/carcara is deprecated; install with `pipx install .` or `uv tool install .`' >&2
command -v python3 > /dev/null 2>&1 || { echo "carcara: python3 not found (need Python >= 3.10)" >&2; exit 1; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' \
  || { echo "carcara: Python >= 3.10 required (found $(python3 -V 2>&1))" >&2; exit 1; }
PYTHONPATH="$CARCARA_HOME/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m carcara "$@"
